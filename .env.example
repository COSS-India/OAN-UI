# API base. Same-origin when empty. api-service appends "/api/..." to this,
# so for a shared-host sub-path deploy use the PREFIX ONLY (e.g. "/bv" -> "/bv/api/token").
VITE_API_BASE_URL=https://your-project.co
VITE_API_KEY=token-goes-here
# Sub-path the app is served under (e.g. "/bv"). Drives Vite asset base + router basepath.
# Leave empty/unset to serve from root "/".
VITE_BASE_PATH=
# Optional: override the JWT public key used to validate guest tokens (PEM, escaped \n).
# Leave unset to use the default baked into AuthContext.tsx.
VITE_JWT_PUBLIC_KEY=
MODE=development
